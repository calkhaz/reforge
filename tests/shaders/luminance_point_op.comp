#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout (binding = 0, rgba8) uniform image2D io_image;

void main()
{	
    vec4 color = imageLoad(io_image, ivec2(gl_GlobalInvocationID.xy));

    float luma = 0.2126*color.r + 0.7152*color.g + 0.0722*color.b;

    color.rgb = vec3(luma);

    imageStore(io_image, ivec2(gl_GlobalInvocationID.xy), color);
}

